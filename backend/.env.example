# 复制为 .env 后按需修改
APP_NAME=LocalRAG KB
DEBUG=true
DATABASE_URL=postgresql+psycopg2://kb:kb_password@localhost:5432/kb
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_LOCAL_PATH=BAAI/bge-m3

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
USE_RERANK=false
CORS_ORIGINS=
PUBLIC_BASE_URL=http://localhost:5173

# 说明：生产部署必须用 DEBUG=false 且设置强随机 JWT_SECRET，否则启动会被拒绝。
# 容器化部署请改用根目录 .env（compose 变量），此处仅用于本地裸跑开发。
