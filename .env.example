# ===== 必填：生产环境必须的强随机密钥（生成：openssl rand -hex 32）=====
JWT_SECRET=change-me-to-a-long-random-string

# ===== 数据库 =====
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_password
POSTGRES_DB=kb

# ===== 对外 Web 端口 =====
WEB_PORT=80

# ===== 跨域白名单（逗号分隔，可选；留空则仅同源可用）=====
# 例：CORS_ORIGINS=https://kb.example.com,https://app.example.com
CORS_ORIGINS=

# ===== RAG - Embedding =====
# local  : 容器内 sentence-transformers（需 INSTALL_RAG_DEPS=1 构建），首次下载 BAAI/bge-m3(~2GB)
# ollama : 使用 ollama 服务（docker compose --profile ollama 启动）
# openai : 任意 OpenAI 兼容云 API（填 EMBEDDING_API_BASE / EMBEDDING_API_KEY）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# ===== RAG - LLM =====
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://ollama:11434
LLM_API_BASE=
LLM_API_KEY=

# ===== 分享链接站点地址（生成外链时使用）=====
PUBLIC_BASE_URL=http://localhost

# ===== 是否将本地 Embedding 依赖固化进镜像（1=是，构建约多 5-10 分钟）=====
INSTALL_RAG_DEPS=0

# ===== 检索重排（融合召回后的词法重排，中文友好；false 退回纯 RRF）=====
USE_RERANK=true

# ===== 检索增强 =====
# MMR 多样性重排（减少返回高度重复片段）
USE_MMR=true
MMR_LAMBDA=0.7
# 父块上下文扩展（小切片召回 + 邻块补全上下文）
PARENT_EXPAND=true
PARENT_WINDOW=1
# 喂给 LLM 的上下文总字符预算
MAX_CONTEXT_CHARS=6000
# 精排方式：lexical（默认，无需模型）| cross-encoder（需 sentence-transformers + 模型）
RERANK_PROVIDER=lexical

# ===== Query 改写/扩展（需 LLM 可用；失败自动回退为原查询）=====
USE_QUERY_REWRITE=false
QUERY_REWRITE_COUNT=3
